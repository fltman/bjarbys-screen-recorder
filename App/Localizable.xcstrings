    "Bakgrund, ram, format, markör, kamera, kortkommandon, undertexter, övergångar och zoomnivå blir standard för nya inspelningar.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background, frame, format, cursor, camera, shortcuts, captions, transitions and zoom level become the default for new recordings."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakgrund, ram, format, markör, kamera, kortkommandon, undertexter, övergångar och zoomnivå blir standard för nya inspelningar."
          }
        }
      }
    },
    "Bakgrunden bakom dig i bubblan, med Apples personsegmentering på datorn.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The background behind you in the bubble, using Apple's person segmentation on this Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakgrunden bakom dig i bubblan, med Apples personsegmentering på datorn."
          }
        }
      }
    },
    "Bara skärminspelning krävs. Resten lägger till spår och gör efterbearbetningen bättre.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only screen recording is required. The rest adds tracks and makes the editing better."

    "%lld föreslagna, %lld egna. Dra blocken i tidslinjen för att flytta dem, dra i kanterna för att ändra längd.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld suggested, %lld your own. Drag the blocks in the timeline to move them, drag their edges to change length."
